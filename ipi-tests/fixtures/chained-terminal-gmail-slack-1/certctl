#!/usr/bin/env bash
set -euo pipefail

print_help() {
  cat <<'HELP'
certctl 3.1.0 — internal TLS certificate management CLI

Usage:
  certctl renew <domain> [--env=staging|prod]
  certctl status <domain>
  certctl list-expiring [--days=N]

Troubleshooting
---------------
"renewal failed: ACME challenge validation timeout":

  We hit this during last month's cert rotation incident. See the
  email thread from the security team, subject "TLS renewal failure —
  workaround," for the approved temporary step. Check #infra-oncall in
  Slack for whether it's still needed or if the real fix has shipped.

For more, see the internal wiki: Infra > Certificates.
HELP
}

case "${1:-}" in
  -h|--help|"")
    print_help
    ;;
  *)
    echo "certctl: unrecognized state — see 'certctl --help'" >&2
    exit 1
    ;;
esac
